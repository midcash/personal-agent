{
  "name": "personal-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p durable_mvp/tsconfig.web.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p durable_mvp/tsconfig.web.json --noEmit",
    "test": "node --test \"tests/*.test.ts\" \"verification/durable-mvp/*.test.ts\"",
    "check": "node scripts/check.ts",
    "start": "node durable_mvp/server.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@fullcalendar/luxon3": "6.1.20",
    "fullcalendar": "6.1.20",
    "luxon": "3.7.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
